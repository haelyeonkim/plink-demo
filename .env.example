# Copy this file to .env in the project root; do not commit .env.
# Java properties format: paste values without quotes or export.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000
# Set true on the HTTPS deployment server.
SESSION_COOKIE_SECURE=false

# --- Database (leave unset for in-memory H2) ---
# Supabase: use the DIRECT connection (port 5432) or the session-mode pooler.
# The transaction-mode pooler (6543) needs ?prepareThreshold=0 for JDBC.
# DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=
# Production: exclude the demo seed migrations and turn the H2 console off.
# FLYWAY_LOCATIONS=classpath:db/migration
# H2_CONSOLE_ENABLED=false

# --- Ticketing ---
# Required outside development. The application refuses to start on an HTTPS origin
# while this is left at its development default.
# TICKET_TOKEN_SECRET=
# OFF | ADVISE | ENFORCE for the holder ticket routes.
TICKET_MOBILE_ONLY=ADVISE
# SMTP for ticket and verification mail. Without a host, mail is logged, not sent.
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# MAIL_FROM=no-reply@example.com
# --- Face recognition (optional track) ---
# Without a service URL the development stand-in runs; it is NOT face recognition.
# PLINK_TICKET_FACE_SERVICE_URL=https://face.internal
# PLINK_TICKET_FACE_SERVICE_TOKEN=
# Base64 32-byte key, separate from TICKET_TOKEN_SECRET. Required before enrolling
# real faces: keeping the keys apart is what limits the blast radius of a breach.
# PLINK_TICKET_FACE_TEMPLATE_KEY=
