# Copy this file to .env in the project root; do not commit .env.
# Java properties format: paste values without quotes or export.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google sign-in opens both consoles, so it is limited to these. Comma-separated.
# Domains match the Workspace "hd" claim (consumer gmail.com accounts never carry one);
# emails match exactly. With both empty, every Google sign-in is refused.
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=
APP_BASE_URL=http://localhost:3000
# Set true on the HTTPS deployment server.
SESSION_COOKIE_SECURE=false
# Behind a reverse proxy every request otherwise appears to come from the proxy, and the
# sign-in and protected-link attempt limits then count all visitors as one. NATIVE reads
# the client from X-Forwarded-For, trusting it only from private-range proxies (Tomcat's
# default); a proxy on a public address also needs the OS environment variable
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES set to a regex of its address.
# FORWARD_HEADERS_STRATEGY=NATIVE
# Failed sign-ins and protected-link attempts are also capped per client across accounts
# and links. If the proxy in front does not send X-Forwarded-For, every visitor is one
# client and the cap locks everyone out together: turn it off with 0.
# plink.admin.max-failures-per-client=0
# plink.links.max-failures-per-client=0

# --- Database (leave unset for in-memory H2) ---
# Supabase: use the DIRECT connection (port 5432) or the session-mode pooler.
# The transaction-mode pooler (6543) needs ?prepareThreshold=0 for JDBC.
# DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=
# Production: exclude the demo seed migrations and turn the H2 console off.
# FLYWAY_LOCATIONS=classpath:db/migration
# H2_CONSOLE_ENABLED=false

# --- Ticketing ---
# Required outside development. The application refuses to start on an HTTPS origin
# while this is left at its development default.
# TICKET_TOKEN_SECRET=
# OFF | ADVISE | ENFORCE for the holder ticket routes.
TICKET_MOBILE_ONLY=ADVISE
# SMTP for ticket and verification mail. Without a host, mail is logged, not sent.
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# MAIL_FROM=no-reply@example.com
# --- Face recognition (optional track) ---
# Without a service URL the development stand-in runs; it is NOT face recognition.
# PLINK_TICKET_FACE_SERVICE_URL=https://face.internal
# PLINK_TICKET_FACE_SERVICE_TOKEN=
# Base64 32-byte key, separate from TICKET_TOKEN_SECRET. Required before enrolling
# real faces: keeping the keys apart is what limits the blast radius of a breach.
# PLINK_TICKET_FACE_TEMPLATE_KEY=
# --- Field operations ---
# Location binding is per session (venue coordinates, radius, OFF/ADVISE/ENFORCE) and is
# configured from the organiser console, not here.

# Private artwork images. Local files must live on a persistent, backed-up volume.
plink.images.backend=local
plink.images.directory=./data/content-images
# To use a pre-created PRIVATE Supabase bucket, set backend=supabase and:
# plink.images.supabase-url=https://PROJECT.supabase.co
# plink.images.supabase-key=SERVER_SERVICE_ROLE_KEY
# plink.images.bucket=content-images
